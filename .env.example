# Web Push（运行一次生成密钥，填入 Vercel Environment Variables）
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 联系人 URI，合规要求（可填你的邮箱）
VAPID_SUBJECT=mailto:you@example.com

# Vercel 项目 → Storage → Create Database → KV，连接后自动注入（或手动填写）
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Cron 调用 /api/cron/check-new 时会校验；在 Project Settings → Cron Jobs 启用后可在 Environment 里查看
CRON_SECRET=

# 可选：推送点击跳转的完整站点根 URL（若通知里打开页面路径不对时配置）
# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# 可选：覆盖 Haven Storefront Token（默认已内置兜底）
# HAVEN_STOREFRONT_TOKEN=
