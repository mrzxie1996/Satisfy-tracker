# Web Push（运行一次生成密钥，填入 Vercel Environment Variables）
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 联系人 URI，合规要求（可填你的邮箱）
VAPID_SUBJECT=mailto:you@example.com

# Vercel 项目 → Storage → Create Database → KV，连接后自动注入（或手动填写）
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 可选：通知内链接站点根（不设则用 VERCEL_URL）
SITE_URL=https://satisfy-tracker.vercel.app

# 随机长字符串。外部定时器（如 cron-job.org）GET /api/cron/check-new 时须在请求头加：
#   Authorization: Bearer <CRON_SECRET>
# 未设置则任何人可触发检查（不推荐公开部署）。
CRON_SECRET=

# --- cron-job.org 示例（北京时间每天 8 次，与 Vercel Hobby 搭配）---
# URL:    https://<你的项目>.vercel.app/api/cron/check-new
# Method: GET
# Header: Authorization = Bearer <上面 CRON_SECRET 的值>
# Schedule: Cron expression，时区 Asia/Shanghai，填：
#   0 0,3,6,9,12,15,18,21 * * *
# （0/3/6/9/12/15/18/21 点整各跑一次）
#
# refresh-end 若仍写在 vercel.json 里，Hobby 可能仍受「每天一次」限制；若部署报错，可把 refresh-end
# 也迁到 cron-job.org，或改为低频 / 仅手动触发。

# PushPlus（微信等），可选
# PUSHPLUS_TOKEN=

# 可选：覆盖 Haven Storefront Token（默认已内置兜底）
# HAVEN_STOREFRONT_TOKEN=
